# Dashboard port
PORT=3000

# Password to log into the dashboard (required)
DASHBOARD_PASSWORD=

# Session cookie signing secret (e.g. openssl rand -hex 24)
SESSION_SECRET=

# Palworld server REST API (RESTAPIEnabled=True in the .ini)
# "auto": if the dashboard runs on WSL and the server on Windows,
# the Windows host IP is detected automatically
PALWORLD_HOST=127.0.0.1
PALWORLD_API_PORT=8212
# AdminPassword defined in PalWorldSettings.ini
PALWORLD_ADMIN_PASSWORD=

# Absolute path to PalWorldSettings.ini
# Linux: ~/Steam/steamapps/common/PalServer/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
# WSL: /mnt/c/Program Files (x86)/Steam/steamapps/common/PalServer/Pal/Saved/Config/WindowsServer/PalWorldSettings.ini
PALWORLD_INI_PATH=

# Command run to restart the server after writing the .ini
# Native Linux: "systemctl restart palworld" or "docker restart palworld"
# WSL + Windows Steam server: "bash /path/to/scripts/restart-palserver.sh"
PALWORLD_RESTART_CMD=
