# Port du dashboard
PORT=3000

# Mot de passe de connexion au dashboard (obligatoire)
DASHBOARD_PASSWORD=

# Secret de signature des cookies de session
SESSION_SECRET=

# API REST du serveur Palworld (RESTAPIEnabled=True dans le .ini)
PALWORLD_HOST=127.0.0.1
PALWORLD_API_PORT=8212
# AdminPassword défini dans PalWorldSettings.ini
PALWORLD_ADMIN_PASSWORD=

# Chemin absolu vers PalWorldSettings.ini
# Linux : ~/Steam/steamapps/common/PalServer/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
# Windows : C:\steamcmd\steamapps\common\PalServer\Pal\Saved\Config\WindowsServer\PalWorldSettings.ini
PALWORLD_INI_PATH=

# Commande exécutée pour redémarrer le serveur après écriture du .ini
# Exemples : "systemctl restart palworld" ou "docker restart palworld"
PALWORLD_RESTART_CMD=
