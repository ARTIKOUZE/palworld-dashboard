# Port du dashboard
PORT=3000

# Mot de passe de connexion au dashboard (obligatoire)
DASHBOARD_PASSWORD=

# Secret de signature des cookies de session (ex : openssl rand -hex 24)
SESSION_SECRET=

# API REST du serveur Palworld (RESTAPIEnabled=True dans le .ini)
# "auto" : si le dashboard tourne sous WSL et le serveur sous Windows,
# l'IP de l'hôte Windows est détectée automatiquement
PALWORLD_HOST=127.0.0.1
PALWORLD_API_PORT=8212
# AdminPassword défini dans PalWorldSettings.ini
PALWORLD_ADMIN_PASSWORD=

# Chemin absolu vers PalWorldSettings.ini
# Linux : ~/Steam/steamapps/common/PalServer/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
# WSL : /mnt/c/Program Files (x86)/Steam/steamapps/common/PalServer/Pal/Saved/Config/WindowsServer/PalWorldSettings.ini
PALWORLD_INI_PATH=

# Commande exécutée pour redémarrer le serveur après écriture du .ini
# Linux natif : "systemctl restart palworld" ou "docker restart palworld"
# WSL + serveur Steam Windows : "bash /chemin/vers/scripts/restart-palserver.sh"
PALWORLD_RESTART_CMD=
